# ── Golify backend environment ─────────────────────────────────────────────
# Copy to .env and adjust. godotenv loads this file on startup.
# Real environment variables always take precedence over .env.
#
#   cp .env.example .env
#
# All binds are ":port" — omit the host to listen on all interfaces.

# Proxy HTTP + ACME solver (API-only, no SPA fallback so ACME passes)
GOTIFY_HTTP=:20001

# Proxy HTTPS (full SPA + API, TLS terminated in-process)
GOTIFY_HTTPS=:20002

# Dashboard + API + WebSocket — unified single port. The WebSocket is
# served directly by Go (no separate WS backend).
GOTIFY_FE=:20003

# Proxy all-in-one (HTTP+HTTPS on ONE port) for Cloudflare tunnel
# single-rule ingress — simtaru.online / wajadi.online tests.
GOTIFY_DUAL=:8080

# Optional: data directory (defaults to ./data)
# GOTIFY_DATA=./data

# Optional: override the JWT signing key path (defaults to data/jwt.key)
# GOTIFY_JWT_KEY=./data/jwt.key
