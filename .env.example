# ── Golify backend environment ─────────────────────────────────────────────
# Copy to .env and adjust. godotenv loads this file on startup.
# Real environment variables always take precedence over .env.
#
#   cp .env.example .env
#
# All binds are ":port" — omit the host to listen on all interfaces.

# BE Go: API + WS dashboard (WS prefix /api/ws/*). No SPA — FE lives on
# GOTIFY_FE (:20003) as a Vite dev server.
GOTIFY_BE=:20000

# Proxy HTTP + ACME → FE (GOTIFY_FE)
GOTIFY_HTTP=:20001

# Proxy HTTPS → FE (GOTIFY_FE)
GOTIFY_HTTPS=:20002

# FE Vue Vite dev server. The Go binary does NOT listen here — the proxy
# ports (20001/20002/8080) forward to this address. Vite proxies /api → BE.
GOTIFY_FE=:20003

# Proxy all-in-one (HTTP+HTTPS+ACME on ONE port) → FE (GOTIFY_FE)
# Cloudflare tunnel single-rule ingress — simtaru.online / wajadi.online.
GOTIFY_DUAL=:8080

# Optional: data directory (defaults to ./data)
# GOTIFY_DATA=./data

# Optional: override the JWT signing key path (defaults to data/jwt.key)
# GOTIFY_JWT_KEY=./data/jwt.key
