# ── Golify backend environment ─────────────────────────────────────────────
# Copy to .env and adjust. godotenv loads this file on startup.
# Real environment variables always take precedence over .env.
#
#   cp .env.example .env
#
# All binds are ":port" — omit the host to listen on all interfaces.

# Dashboard (SPA + WebSocket) — served by the embedded frontend in prod,
# or proxied by Vite dev server (web/.env → VITE_DEV_PROXY_API).
GOTIFY_FE=:20002

# Plain HTTP (API + ACME challenge)
GOTIFY_HTTP=:20001

# HTTPS (TLS termination)
GOTIFY_HTTPS=:20003

# Dual HTTP+HTTPS listener for domain-gated proxy hosts (simtaru/wajadi tests)
GOTIFY_DUAL=:8080

# Optional: data directory (defaults to ./data)
# GOTIFY_DATA=./data

# Optional: override the JWT signing key path (defaults to data/jwt.key)
# GOTIFY_JWT_KEY=./data/jwt.key
