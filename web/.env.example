# ── Golify frontend dev environment (Vite) ─────────────────────────────────
# Copy to .env and adjust. All vars MUST start with VITE_ to be exposed.
#
#   cp .env.example .env
#
# VITE_* vars prefixed with VITE_DEV_* are only used by vite.config.ts
# (dev server config). They are NOT bundled into the app.

# Dev server port — FE lives on 20003 (Vite HMR ws on the same port)
VITE_DEV_PORT=20003

# Where the Vite dev server proxies /api → the Go BE (:20000).
# WS dashboard lives at /api/ws/* and passes through the same /api proxy.
VITE_DEV_PROXY_API=http://127.0.0.1:20000
