# ── Golify frontend dev environment (Vite) ─────────────────────────────────
# Copy to .env and adjust. All vars MUST start with VITE_ to be exposed.
#
#   cp .env.example .env
#
# VITE_* vars prefixed with VITE_DEV_* are only used by vite.config.ts
# (dev server config). They are NOT bundled into the app.

# Dev server port (default 5173)
VITE_DEV_PORT=5173

# Where the Vite dev server proxies /api (the Go backend plain-HTTP port)
VITE_DEV_PROXY_API=http://127.0.0.1:20001

# Where the Vite dev server proxies /ws (the Go dashboard/WS port)
VITE_DEV_PROXY_WS=http://127.0.0.1:20003
